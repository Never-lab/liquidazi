      "import": "./avatar.mjs",
      "require": "./avatar.js"
    }
  },
  "sideEffects": false,
  "files": [
    "avatar.js",
    "avatar.mjs",
    "avatar.d.ts",
    "README.md",
    "NOTICE"
  ],
